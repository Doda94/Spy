    "version": "1.0.0",
    "source": "https://claude.ai/artifact/XtN3ran4nCfCovxyvT7gUa",
    "exported": "2026-10-16",
    "themes": [
      "dark (default)",
      "light"
    ],
    "composeEntryPoint": "SpyTheme(themeSetting, displayFamily = bricolage(), textFamily = hanken())",
    "accessors": "Spy.colors.<token>, Spy.type.<token>, SpyShape.<token>, SpySpace.<token>, SpyMotion.<token>"
  },
