  "font": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": [
          "Bricolage Grotesque"
        ],
        "$description": "Card layer: card words, role, large titles, results. OFL. Weights 700/800. Variable: opsz 12–96 (use 48–96 for display). Bundle as Compose resource (shared iOS+Android)."
      },
      "text": {
        "$type": "fontFamily",
        "$value": [
          "Hanken Grotesk"
        ],
        "$description": "Table layer: all UI text. OFL. Weights 400/500/600/700. Tabular figures (tnum) for timer, counts, room codes — VERIFY the shipped font has tnum; fallback = fixed-width Box per digit."
      },
      "mono": {
        "$type": "fontFamily",
        "$value": [
          "JetBrains Mono"
        ],
        "$description": "Design-doc annotations only (not used in the app)."
      },
      "diacritics": {
        "$type": "string",
        "$value": "Latin Extended-A verified: Č Ć Š Ž Đ č ć š ž đ"
      }
    }
  },
